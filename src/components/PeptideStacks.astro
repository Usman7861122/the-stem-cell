---
import { stacks, blendInfo } from '../data/stacks';
---

<section id="peptide-stacks" aria-labelledby="stacks-title" class="section-pad bg-sand text-ink">
  <div class="container-x">
    <p class="eyebrow">Peptide Therapy</p>
    <h2 id="stacks-title" class="h-section mt-5 max-w-3xl">Peptide <em class="text-gold-deep">stacks</em></h2>
    <p class="lead mt-5 max-w-2xl">
      Ready-made combinations of peptides, offered after a physician evaluation. Your physician decides if a stack is right for you.
    </p>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        stacks.map((s) => (
          <li class="list-none">
            <article class="flex h-full flex-col rounded-2xl bg-white shadow-sm ring-1 ring-ink/10 transition duration-300 hover:-translate-y-1 hover:shadow-lg">
              <div class="h-2 rounded-t-2xl" style={`background:${s.color}`} aria-hidden="true" />
              <div class="flex flex-1 flex-col p-7">
                <div class="flex items-start gap-4">
                  <span
                    class="grid h-12 w-12 shrink-0 place-items-center rounded-full font-serif text-xl"
                    style={`background:${s.color};color:${s.dark ? '#0a1a2f' : '#fff'}`}
                    aria-hidden="true"
                  >
                    {s.name.charAt(0)}
                  </span>
                  <h3 class="font-serif text-2xl leading-tight">{s.name}</h3>
                </div>
                <ul class="mt-5 flex flex-wrap gap-2">
                  {
                    s.peptides.map((p) => (
                      <li class="relative list-none">
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-sand px-3 py-1 text-sm font-semibold text-navy">
                          {p}
                          {blendInfo[p] && (
                            <span class="group/tip relative inline-flex">
                              <button
                                type="button"
                                aria-label={`About ${p}`}
                                aria-describedby={`tip-${s.name.replace(/\W+/g, '-')}-${p.replace(/\W+/g, '-')}`}
                                class="grid h-5 w-5 place-items-center rounded-full border border-navy/40 font-serif text-xs italic leading-none text-navy transition hover:bg-navy hover:text-white focus-visible:bg-navy focus-visible:text-white"
                              >
                                i
                              </button>
                              <span
                                role="tooltip"
                                id={`tip-${s.name.replace(/\W+/g, '-')}-${p.replace(/\W+/g, '-')}`}
                                class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 w-56 -translate-x-1/2 rounded-lg bg-ink px-3 py-2 text-left text-xs font-normal leading-relaxed text-ivory opacity-0 shadow-lg transition  group-hover/tip:opacity-100  group-focus-within/tip:opacity-100"
                              >
                                {blendInfo[p]}
                              </span>
                            </span>
                          )}
                        </span>
                      </li>
                    ))
                  }
                </ul>
                <p class="mt-auto pt-6 text-sm text-slate">MSRP</p>
                <p class="font-serif text-3xl text-gold-deep">{s.price}</p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a href="/#contact" class="btn btn-primary">Book a Peptide Consultation</a>
      <a href="/peptide-therapy/" class="font-semibold text-navy underline-offset-4 hover:text-gold-deep hover:underline">About peptide therapy</a>
    </div>
    <p class="mt-6 max-w-3xl text-sm text-slate">
      Prices are suggested retail (MSRP) and may change. Peptide therapy is directed by a licensed physician after an evaluation. Results vary and are not guaranteed.
    </p>
  </div>
</section>
