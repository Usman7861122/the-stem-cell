---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/layout/Footer.astro';
import { getPhotos } from '../lib/images';
import { site } from '../data/content';
import Header from '../islands/interactive/Header';
import PageHero from '../islands/interactive/PageHero';
import Contact from '../islands/interactive/Contact';
import Locations from '../islands/interactive/Locations';

const p = await getPhotos();
const url = new URL('/contact', site.url).href;
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site.url).href },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: url },
  ],
};
---

<BaseLayout
  title="Contact & Book a Consultation | The Stem Cell Institute, Sarasota & Venice, FL"
  description="Contact The Stem Cell Institute in Sarasota or Venice, Florida. Call (941) 371-7171 or send a message to book your consultation."
  extraJsonLd={[breadcrumbs]}
>
  <Header client:load logo={p.logo} logoLight={p.logoLight} />
  <main id="main">
    <PageHero
      client:load
      crumb="Contact"
      eyebrow="Contact us"
      title={["Let's start with a", 'conversation', '']}
      lead="Call us, visit a clinic, or send a message. Our team will reply and help you book your consultation."
      showContact
    />
    <Contact client:visible photo={p.reception} />
    <Locations client:visible />
  </main>
  <Footer />
</BaseLayout>
