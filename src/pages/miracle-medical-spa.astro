---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/layout/Footer.astro';
import { getPhotos, type Photo } from '../lib/images';
import { locations, site } from '../data/content';
import { miracleDevices } from '../data/miracle';
import Header from '../islands/interactive/Header';
import Contact from '../islands/interactive/Contact';

const p = (await getPhotos()) as unknown as Record<string, Photo> & { logo: Photo; reception: Photo };
const url = new URL('/miracle-medical-spa/', site.url).href;
const title = 'MIRACLE Medical Spa in Sarasota, FL | Stem Cell Institute';
const description =
  'MIRACLE Medical Spa offers Emsculpt, Emsella, Exomind and Emvital in Sarasota and Venice, Florida. Book a physician evaluation to see which one fits you.';

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site.url).href },
    { '@type': 'ListItem', position: 2, name: 'MIRACLE Medical Spa', item: url },
  ],
};
const page = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: 'MIRACLE Medical Spa',
  url,
  description,
  provider: {
    '@type': 'MedicalBusiness',
    name: site.name,
    telephone: site.phone,
    areaServed: locations.map((l) => ({ '@type': 'City', name: l.city })),
  },
};
const blurbs: Record<string, string> = {
  emsculpt: 'Electromagnetic muscle stimulation to help tone and strengthen.',
  emsella: 'A seated, fully clothed treatment to strengthen pelvic floor muscles.',
  exomind: 'Non-invasive magnetic stimulation for eligible adults with depression.',
  emvital: 'Gentle therapeutic heat for temporary relief of muscle and joint discomfort.',
};
const steps = [
  { t: 'Evaluation', d: 'Meet a physician to talk about your goals, history and health.' },
  { t: 'Diagnosis', d: 'We decide together if one of these treatments is a safe, good fit.' },
  { t: 'Treatment plan', d: 'You get a clear plan: which machine, how long and how often.' },
  { t: 'Follow-up', d: 'We check your progress and adjust the plan with you.' },
];
---

<BaseLayout title={title} description={description} extraJsonLd={[breadcrumbs, page]}>
  <Header client:load logo={p.logo} logoLight={p.logoLight} />
  <main id="main">
    <section data-dark class="relative overflow-hidden bg-ink pb-12 pt-28 text-ivory lg:pb-16 lg:pt-32">
      <div class="container-x relative">
        <nav aria-label="Breadcrumb" class="mb-6 text-sm text-mist">
          <a href="/" class="underline-offset-4 hover:text-gold hover:underline">Home</a>
          <span aria-hidden> / </span>
          <span aria-current="page" class="font-semibold text-ivory">MIRACLE Medical Spa</span>
        </nav>
        <p class="eyebrow eyebrow-dark">Sarasota · Venice · Florida</p>
        <h1 class="h-section mt-5 max-w-3xl">
          <em class="text-gold">MIRACLE</em> Medical Spa
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-mist sm:text-lg">
          Four advanced BTL technologies, guided by a physician. Start with an evaluation, a diagnosis and a clear treatment plan
          built around you.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="/#contact" class="btn btn-gold">Book a Consultation</a>
          <a href={site.phoneHref} class="inline-flex min-h-11 items-center gap-2 font-semibold hover:text-gold">{site.phone}</a>
        </div>
      </div>
    </section>

    <section class="section-pad bg-ivory text-ink">
      <div class="container-x">
        <p class="eyebrow">Our technology</p>
        <h2 class="h-section mt-5">Choose what to <em class="text-gold-deep">explore</em></h2>
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            miracleDevices.map((d) => (
              <a href={d.href} class="block rounded-2xl bg-sand p-8 transition-shadow hover:shadow-lg lg:p-10">
                <h3 class="font-serif text-3xl">{d.name}</h3>
                <p class="mt-3 text-slate">{blurbs[d.slug]}</p>
                <span class="mt-5 inline-block font-semibold text-gold-deep">Learn more about {d.name} →</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section data-dark class="section-pad bg-navy text-ivory">
      <div class="container-x">
        <p class="eyebrow eyebrow-dark">How it works</p>
        <h2 class="h-section mt-5">From evaluation to <em class="text-gold">treatment plan</em></h2>
        <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {
            steps.map((s, i) => (
              <li class="rounded-2xl border border-white/15 bg-white/5 p-8">
                <span class="font-serif text-4xl text-gold">{i + 1}</span>
                <h3 class="mt-3 text-xl font-semibold">{s.t}</h3>
                <p class="mt-2 text-mist">{s.d}</p>
              </li>
            ))
          }
        </ol>
        <p class="mt-10 max-w-2xl text-sm text-ivory/80">
          Medically reviewed by <strong class="font-semibold text-ivory">William J. Cole Jr., D.O.</strong>
        </p>
        <p class="mt-3 max-w-2xl text-sm text-mist">
          This page is for general information and is not medical advice. Treatment is directed by a licensed physician after an
          evaluation. Results vary and are not guaranteed. All four treatments are offered at our Sarasota and Venice clinics.
        </p>
      </div>
    </section>

    <Contact client:visible photo={p.reception} />
  </main>
  <Footer />
</BaseLayout>
