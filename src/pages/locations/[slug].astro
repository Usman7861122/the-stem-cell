---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/layout/Footer.astro';
import { getPhotos } from '../../lib/images';
import { clinicSchema } from '../../lib/schema';
import { locations, site } from '../../data/content';
import Header from '../../islands/interactive/Header';
import LocationDetail from '../../islands/interactive/LocationDetail';
import Contact from '../../islands/interactive/Contact';

export function getStaticPaths() {
  return locations.map((l) => ({ params: { slug: l.id } }));
}
const { slug } = Astro.params;
const l = locations.find((x) => x.id === slug)!;
const p = await getPhotos();
const url = new URL(`/locations/${l.id}/`, site.url).href;
const heroKey = l.id === 'sarasota' ? 'consultation' : 'reception';
const title = `${l.city}, FL Clinic: Address & Hours | Stem Cell Institute`;
const shortStreet = l.street.split(',')[0];
const description = `Visit our ${l.city} clinic at ${shortStreet}${shortStreet.endsWith('.') ? '' : '.'} See hours, directions and treatments, including stem cell and hormone therapy. Call ${site.phone} to book.`;

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site.url).href },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: new URL('/locations/', site.url).href },
    { '@type': 'ListItem', position: 3, name: l.name, item: url },
  ],
};
const clinic = clinicSchema(l, url);
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: l.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title={title} description={description} extraJsonLd={[breadcrumbs, clinic, faq]}>
  <Header client:load logo={p.logo} logoLight={p.logoLight} />
  <main id="main">
    <LocationDetail client:load slug={l.id} hero={(p as any)[heroKey]} />
    <Contact client:visible photo={p.reception} />
  </main>
  <Footer />
</BaseLayout>
