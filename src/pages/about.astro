---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/layout/Footer.astro';
import { getPhotos } from '../lib/images';
import { site } from '../data/content';
import Header from '../islands/interactive/Header';
import PageHero from '../islands/interactive/PageHero';
import About from '../islands/interactive/About';
import WhyChoose from '../islands/interactive/WhyChoose';
import Physician from '../islands/interactive/Physician';
import Path from '../islands/interactive/Path';
import Locations from '../islands/interactive/Locations';
import Contact from '../islands/interactive/Contact';

const p = await getPhotos();
const url = new URL('/about', site.url).href;
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site.url).href },
    { '@type': 'ListItem', position: 2, name: 'About', item: url },
  ],
};
---

<BaseLayout
  title="About The Stem Cell Institute | Physician-Led Regenerative Medicine in Sarasota & Venice"
  description="Learn about The Stem Cell Institute: physician-led regenerative care in Sarasota and Venice, Florida. Meet our approach, our physician and the way we care for you."
  extraJsonLd={[breadcrumbs]}
>
  <Header client:load logo={p.logo} logoLight={p.logoLight} />
  <main id="main">
    <PageHero
      client:load
      crumb="About"
      eyebrow="About the Institute"
      title={['Care that helps your body', 'heal', 'itself']}
      lead="We are a physician-led wellness center in Sarasota and Venice, Florida. We listen first, explain in plain words, and build a plan around you."
    />
    <About client:visible />
    <WhyChoose client:visible />
    <Physician client:visible photo={p.doctorPortrait} />
    <Path client:visible />
    <Locations client:visible />
    <Contact client:visible photo={p.reception} />
  </main>
  <Footer />
</BaseLayout>
