---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/layout/Footer.astro';
import { getPhotos } from '../lib/images';

import Header from '../islands/interactive/Header';
import Hero from '../islands/interactive/Hero';
import Highlights from '../islands/interactive/Highlights';
import Pillars from '../islands/interactive/Pillars';
import About from '../islands/interactive/About';
import RebuildingBrains from '../islands/interactive/RebuildingBrains';
import Care from '../islands/interactive/Care';
import WhyChoose from '../islands/interactive/WhyChoose';
import Physician from '../islands/interactive/Physician';
import Path from '../islands/interactive/Path';
import Testimonials from '../islands/interactive/Testimonials';
import Gallery from '../islands/interactive/Gallery';
import Locations from '../islands/interactive/Locations';
import Contact from '../islands/interactive/Contact';

const p = await getPhotos();

const galleryItems = [
  { photo: p.consultation, span: 'col-span-2 row-span-2', position: '30% 50%' },
  { photo: p.doctorPortrait, span: 'row-span-2', position: '50% 20%' },
  { photo: p.reception, span: '' },
  { photo: p.ultrasound, span: 'row-span-2', position: '50% 60%' },
  { photo: p.building, span: 'col-span-2' },
  { photo: p.spineModel, span: '', position: '40% 40%' },
  { photo: p.footCare, span: 'col-span-2', position: '50% 55%' },
  { photo: p.teamSkeleton, span: 'col-span-2', position: '50% 45%' },
];
---

<BaseLayout
  title="The Stem Cell Institute | Regenerative Medicine in Sarasota & Venice, FL"
  description="Physician-led regenerative medicine in Sarasota and Venice, Florida. Stem cell therapy, exosome therapy, peptide therapy, hormone therapy, weight loss and IV therapy, built around you."
>
  <Header client:load logo={p.logo} logoLight={p.logoLight} />
  <main id="main">
    <Hero client:load banner={p.banner} />
    <Highlights client:visible />
    <Pillars
      client:visible
      photos={{ spineModel: p.spineModel, ultrasound: p.ultrasound, consultation: p.consultation }}
    />
    <About client:visible />
    <RebuildingBrains client:visible photo={p.brainsScanDoctor} />
    <Care
      client:visible
      photos={{
        consultation: p.consultation,
        ultrasound: p.ultrasound,
        spineModel: p.spineModel,
        teamSkeleton: p.teamSkeleton,
        doctorPortrait: p.doctorPortrait,
        reception: p.reception,
        hormoneLab: p.hormoneLab,
      }}
    />
    <WhyChoose client:visible />
    <Path client:visible />
    <Physician client:visible photo={p.doctorPortrait} />
    <Testimonials client:visible />
    <Gallery client:visible items={galleryItems} />
    <Locations client:visible />
    <Contact client:visible photo={p.reception} />
  </main>
  <Footer />
</BaseLayout>
