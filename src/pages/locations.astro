---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/layout/Footer.astro';
import { getPhotos } from '../lib/images';
import { locations, site, clinicTz } from '../data/content';
import Header from '../islands/interactive/Header';
import LocationsPage from '../islands/interactive/LocationsPage';
import Contact from '../islands/interactive/Contact';

const p = await getPhotos();
const url = new URL('/locations', site.url).href;
const title = 'Locations & Working Hours in Sarasota and Venice, FL | The Stem Cell Institute';
const description =
  'Visit The Stem Cell Institute in Sarasota (4071 Bee Ridge Rd.) or Venice (389 Commercial Ct), Florida. See addresses, working hours, directions and phone number.';

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site.url).href },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: url },
  ],
};

const dayMap = (d: string) => d;
const clinics = locations.map((l) => ({
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: `${site.name} – ${l.name}`,
  url,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: l.street,
    addressLocality: l.city,
    addressRegion: 'FL',
    postalCode: l.zip,
    addressCountry: 'US',
  },
  openingHoursSpecification: l.hours
    .filter((h) => h.open && h.close)
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: dayMap(h.day),
      opens: h.open,
      closes: h.close,
    })),
}));
---

<BaseLayout title={title} description={description} extraJsonLd={[breadcrumbs, ...clinics]}>
  <Header client:load logo={p.logo} logoLight={p.logoLight} />
  <main id="main">
    <LocationsPage client:load hero={p.building} />
    <Contact client:visible photo={p.reception} />
  </main>
  <Footer />
</BaseLayout>
